{
  "manifest_version": 3,
  "name": "Chorus \u2014 coordinated reply detector",
  "version": "0.1.0",
  "description": "Highlights replies that repeat the same wording across many accounts, with the evidence shown.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://www.reddit.com/*",
    "https://old.reddit.com/*",
    "https://bsky.app/*",
    "https://public.api.bsky.app/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://bsky.app/*"
      ],
      "js": [
        "src/content/loader.js"
      ],
      "css": [
        "src/content/ui/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/*"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://bsky.app/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Chorus"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
